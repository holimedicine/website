{
  "name": "holimedicine-website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run build:site && npm run test:e2e:built",
    "build:site": "KEYSTATIC_DISABLED=1 astro build && node scripts/check-dist.mjs",
    "preview": "KEYSTATIC_DISABLED=1 astro preview",
    "test:e2e": "npm run build:site && npm run test:e2e:built",
    "test:e2e:built": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "astro sync && tsc --noEmit",
    "verify": "npm run typecheck && npm run build",
    "prepare": "husky",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.2",
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/react": "^7.0.0",
    "@keystatic/astro": "^6.0.0",
    "@keystatic/core": "^0.6.9",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.3",
    "husky": "^9.1.7",
    "typescript": "^7.0.2"
  }
}
