---
import { getCollection } from 'astro:content';
import { withBase } from '../utils/url';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const rawPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const currentPath = base && rawPath.startsWith(base) ? rawPath.slice(base.length) || '/' : rawPath;

const instagramUrl = 'https://www.instagram.com/holimedicine/?utm_source=ig_web_button_share_sheet';

const recipeCategories = (await getCollection('kategoriePrzepisow')).sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title, 'pl')
);

type NavChild = {
  href: string;
  label: string;
  /** Route that marks this child as current; omit for in-page anchors like recipe categories. */
  page?: string;
};

type NavChildLink = NavChild & {
  isCurrent: boolean;
};

type NavLink = {
  href: string;
  label: string;
  section?: string;
  page?: string;
  /** Marks the site root as this link's current page. */
  home?: boolean;
  isCurrent: boolean;
  children: NavChildLink[];
};

type NavLinkSource = {
  href: string;
  label: string;
  section?: string;
  page?: string;
  /** Marks the site root as this link's current page. */
  home?: boolean;
  /** Extra pages that should mark this link as current, e.g. a hub and its children. */
  pages?: string[];
  children?: NavChild[];
};

const isCurrentPage = (page: string) =>
  currentPath === `/${page}` || currentPath.startsWith(`/${page}/`);

const isCurrentLink = (link: { home?: boolean; page?: string; pages?: string[] }) =>
  (link.home === true && currentPath === '/') ||
  (link.pages ?? (link.page ? [link.page] : [])).some(isCurrentPage);

const links: NavLink[] = (
  [
    { href: '/', label: 'Start', home: true },
    { href: '/#o-nas', label: 'O nas', section: 'o-nas' },
    { href: '/#podejscie', label: 'Medycyna holistyczna', section: 'podejscie' },
    { href: '/#zakres', label: 'Zakres opieki', section: 'zakres' },
    {
      href: '/przepisy',
      label: 'Przepisy',
      page: 'przepisy',
      children: recipeCategories.map((category) => ({
        href: `/przepisy/#${category.id}`,
        label: category.data.title,
      })),
    },
    {
      href: '/baza-wiedzy',
      label: 'Baza wiedzy',
      page: 'baza-wiedzy',
      pages: ['baza-wiedzy', 'edukacja', 'produkty'],
      children: [
        {
          href: '/edukacja/',
          label: 'Materiały edukacyjne',
          page: 'edukacja',
        },
        {
          href: '/produkty/',
          label: 'Polecane produkty',
          page: 'produkty',
        },
      ],
    },
    {
      href: '/wspolpraca',
      label: 'Współpraca',
      page: 'wspolpraca',
      children: [
        {
          href: '/wspolpraca/partnerzy/',
          label: 'Sprawdź z kim współpracujemy',
          page: 'wspolpraca/partnerzy',
        },
      ],
    },
  ] satisfies NavLinkSource[]
).map((link) => ({
  ...link,
  href: withBase(link.href),
  isCurrent: isCurrentLink(link),
  children: (link.children ?? []).map((child) => ({
    ...child,
    href: withBase(child.href),
    isCurrent: child.page ? currentPath === `/${child.page}` : false,
  })),
}));

const ctaLabel = 'Umów wizytę';
const isSearchCurrent = currentPath === '/szukaj';

interface Props {
  /** Fix the nav above the hero instead of keeping it in the document flow. */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
---

<nav class:list={['nav', { 'nav-overlay': overlay }]}>
  <div class="nav-inner">
    <a
      href={instagramUrl}
      class="nav-instagram"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Instagram Holimedicine (otwiera się w nowej karcie)"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <defs>
          <linearGradient id="instagram-gradient" x1="0%" y1="100%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#feda75"></stop>
            <stop offset="30%" stop-color="#fa7e1e"></stop>
            <stop offset="60%" stop-color="#d62976"></stop>
            <stop offset="85%" stop-color="#962fbf"></stop>
            <stop offset="100%" stop-color="#4f5bd5"></stop>
          </linearGradient>
        </defs>
        <rect
          x="3"
          y="3"
          width="18"
          height="18"
          rx="5"
          stroke="url(#instagram-gradient)"></rect>
        <circle cx="12" cy="12" r="4.2" stroke="url(#instagram-gradient)"></circle>
        <circle cx="17.2" cy="6.8" r="1.1" fill="url(#instagram-gradient)" stroke="none"></circle>
      </svg>
      <span class="nav-instagram-wordmark"
        ><span class="nav-instagram-wordmark-holi">holi</span>medicine</span
      >
    </a>

    <div class="nav-links">
      {links.map((link) =>
        link.children.length > 0 ? (
          <div class="nav-item nav-item-has-menu">
            <a
              href={link.href}
              class="nav-trigger"
              data-nav-section={link.section}
              data-nav-page={link.page}
              aria-current={link.isCurrent ? 'page' : undefined}
            >
              {link.label}
              <svg
                class="nav-chevron"
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                focusable="false"
              >
                <path d="m4.5 6.5 3.5 3.5 3.5-3.5"></path>
              </svg>
            </a>

            <div class="nav-menu">
              {link.children.map((child) => (
                <a
                  href={child.href}
                  class="nav-menu-link"
                  data-nav-child-page={child.page}
                  aria-current={child.isCurrent ? 'page' : undefined}
                >
                  <span>{child.label}</span>
                  <svg
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"></path>
                  </svg>
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a
            href={link.href}
            class:list={[{ 'nav-home': link.home }]}
            data-nav-section={link.section}
            data-nav-page={link.page}
            aria-current={link.isCurrent ? 'page' : undefined}
          >
            {link.home && (
              <svg
                class="nav-home-icon"
                viewBox="0 0 20 20"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M3.5 8.5 10 3l6.5 5.5"></path>
                <path d="M5 8v8h10V8"></path>
                <path d="M8.5 16v-4.5h3V16"></path>
              </svg>
            )}
            {link.label}
          </a>
        )
      )}
    </div>

    <a
      href={withBase('/szukaj/')}
      class="nav-search"
      aria-current={isSearchCurrent ? 'page' : undefined}
    >
      <svg
        viewBox="0 0 20 20"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        aria-hidden="true"
        focusable="false"
      >
        <circle cx="8.5" cy="8.5" r="5.5"></circle>
        <path d="m12.6 12.6 4.1 4.1"></path>
      </svg>
      <span>Szukaj</span>
    </a>

    <a href={withBase('/#kontakt')} class="nav-cta">
      {ctaLabel}
      <svg
        class="cta-plus"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M8 3v10M3 8h10"></path>
      </svg>
    </a>

    <button
      class="nav-toggle"
      id="navToggle"
      type="button"
      aria-label="Otwórz menu"
      aria-controls="navMobile"
      aria-expanded="false">☰</button
    >
  </div>

  <div class="nav-mobile" id="navMobile">
    <a href={withBase('/#kontakt')} class="nav-mobile-cta">
      {ctaLabel}
      <svg
        class="cta-plus"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M8 3v10M3 8h10"></path>
      </svg>
    </a>

    <a
      href={withBase('/szukaj/')}
      class="nav-mobile-search"
      aria-current={isSearchCurrent ? 'page' : undefined}
    >
      <svg
        viewBox="0 0 20 20"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        aria-hidden="true"
        focusable="false"
      >
        <circle cx="8.5" cy="8.5" r="5.5"></circle>
        <path d="m12.6 12.6 4.1 4.1"></path>
      </svg>
      <span>Szukaj</span>
    </a>

    {links.map((link) => (
      <>
        <a
          href={link.href}
          class:list={[{ 'nav-home': link.home }]}
          data-nav-section={link.section}
          data-nav-page={link.page}
          aria-current={link.isCurrent ? 'page' : undefined}
        >
          {link.home && (
            <svg
              class="nav-home-icon"
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M3.5 8.5 10 3l6.5 5.5"></path>
              <path d="M5 8v8h10V8"></path>
              <path d="M8.5 16v-4.5h3V16"></path>
            </svg>
          )}
          {link.label}
        </a>
        {link.children.map((child) => (
          <a
            href={child.href}
            class="nav-mobile-sub"
            data-nav-child-page={child.page}
            aria-current={child.isCurrent ? 'page' : undefined}
          >{child.label}</a>
        ))}
      </>
    ))}
  </div>
</nav>
