---
import Layout from './Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  /** Fix the nav to the viewport so a full-bleed hero can start at the top edge. */
  navOverlay?: boolean;
  /** See `Layout.astro`; defaults to the current page path. */
  canonicalPath?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const { title, description, navOverlay = false, canonicalPath, image, type, noindex } =
  Astro.props;
---

<Layout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  image={image}
  type={type}
  noindex={noindex}
>
  <slot name="head" slot="head" />
  <Nav overlay={navOverlay} />
  <slot />
  <Footer />

  <script>
    const yearEl = document.getElementById('year');
    if (yearEl) yearEl.textContent = String(new Date().getFullYear());

    const siteNav = document.querySelector('.nav');
    const navToggle = document.getElementById('navToggle');
    const navMobile = document.getElementById('navMobile');
    const desktopNavQuery = window.matchMedia('(min-width: 1181px)');
    let mobileMenuOpen = false;

    const syncMenuOffset = () => {
      const navHeight = siteNav?.getBoundingClientRect().height ?? 0;
      document.documentElement.style.setProperty('--nav-height', `${navHeight}px`);
    };

    const setMobileMenu = (open: boolean) => {
      if (!navToggle || !navMobile) return;

      if (open) syncMenuOffset();

      mobileMenuOpen = open;
      navMobile.classList.toggle('open', open);
      siteNav?.classList.toggle('menu-open', open);
      navToggle.setAttribute('aria-expanded', String(open));
      navToggle.setAttribute('aria-label', open ? 'Zamknij menu' : 'Otwórz menu');
      document.documentElement.classList.toggle('nav-menu-open', open);
    };

    if (navToggle && navMobile) {
      navToggle.addEventListener('click', () => setMobileMenu(!mobileMenuOpen));

      navMobile.querySelectorAll('a').forEach((a) => {
        a.addEventListener('click', () => setMobileMenu(false));
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && mobileMenuOpen) {
          setMobileMenu(false);
          navToggle.focus({ preventScroll: true });
        }
      });

      // Wheel events over the header must not scroll the page behind the menu.
      // Inside the menu, `overscroll-behavior: contain` stops scroll chaining.
      siteNav?.addEventListener(
        'wheel',
        (event) => {
          if (!mobileMenuOpen) return;
          const target = event.target;
          if (!(target instanceof Node) || !navMobile.contains(target)) {
            event.preventDefault();
          }
        },
        { passive: false }
      );

      desktopNavQuery.addEventListener('change', (event) => {
        if (event.matches) setMobileMenu(false);
      });

      window.addEventListener(
        'resize',
        () => {
          if (mobileMenuOpen) syncMenuOffset();
        },
        { passive: true }
      );
    }

    const sectionIds = ['o-nas', 'podejscie', 'zakres', 'kontakt'];
    const sections = sectionIds
      .map((id) => document.getElementById(id))
      .filter((el) => el !== null);

    if (sections.length > 0) {
      const nav = document.querySelector('.nav');
      const sectionLinks = document.querySelectorAll('[data-nav-section]');
      let frame = 0;

      const updateActiveSection = () => {
        frame = 0;
        const offset = (nav ? nav.clientHeight : 0) + 24;
        let active = null;

        for (const section of sections) {
          if (section.getBoundingClientRect().top - offset <= 0) {
            active = section.id;
          }
        }

        if (active === 'kontakt') active = null;

        sectionLinks.forEach((link) => {
          if (link.getAttribute('data-nav-section') === active) {
            link.setAttribute('aria-current', 'location');
          } else {
            link.removeAttribute('aria-current');
          }
        });
      };

      const scheduleUpdate = () => {
        if (!frame) frame = window.requestAnimationFrame(updateActiveSection);
      };

      window.addEventListener('scroll', scheduleUpdate, { passive: true });
      window.addEventListener('resize', scheduleUpdate, { passive: true });
      updateActiveSection();
    }

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const revealEls = document.querySelectorAll('.reveal');
    if (prefersReduced) {
      revealEls.forEach((el) => el.classList.add('reveal-visible'));
    } else {
      const obs = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('reveal-visible');
              obs.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15 }
      );
      revealEls.forEach((el) => obs.observe(el));
    }
  </script>
</Layout>
