---
import '../styles/global.css';
import { withBase } from '../utils/url';
import { absoluteUrl, normalizePath, SITE_NAME } from '../utils/seo';

interface Props {
  title?: string;
  description?: string;
  /**
   * Path the canonical URL points at. Defaults to the current page path.
   * Useful for pages reachable under several URLs (e.g. `?q=` search links).
   */
  canonicalPath?: string;
  /** Social preview image, root-relative or absolute. Defaults to the 1200×630 card. */
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const DEFAULT_TITLE = `${SITE_NAME} — medycyna holistyczna i terapia manualna`;
const DEFAULT_DESCRIPTION =
  'Medycyna holistyczna i terapia manualna w Zawierciu. Natalia i Donat Cupiał — lekarze rodzinni, którzy łączą diagnostykę, terapię manualną i profilaktykę.';
const DEFAULT_IMAGE = '/images/og-default.jpg';

const {
  title = DEFAULT_TITLE,
  description = DEFAULT_DESCRIPTION,
  canonicalPath,
  image = DEFAULT_IMAGE,
  type = 'website',
  noindex = false,
} = Astro.props;

const canonical = absoluteUrl(canonicalPath ?? normalizePath(Astro.url.pathname));
const imageUrl = /^https?:\/\//i.test(image) ? image : absoluteUrl(withBase(image));
const imageAlt = title;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="icon" href={withBase('/favicon.ico')} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f4f8f7" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : null}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
