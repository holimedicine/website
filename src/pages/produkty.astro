  {
    title: 'Magnez, żelazo, witamina D',
    examples: 'do uzupełnienia',
    body: 'Podstawowe składniki, o których dokładniejsze zalecenia dodamy wkrótce.',
  },
];

const probioticTable = [
  ['IBS (ogólnie)', 'ProbioMax 10 Premium · OMNi-BiOTiC 6/10', 'Preparaty wieloszczepowe poprawiające motorykę jelit.'],
  ['IBS z biegunką', 'Sanprobi IBS · Sanbiotics IBS + Enterol', 'Dodatek S. boulardii szczególnie na początku leczenia.'],
  ['IBS z zaparciami', 'B. lactis (ProbioMax, OMNi-BiOTiC, Lactibiane) · Aliness ProbioBalance IBS', 'Szczepy poprawiające motorykę jelit.'],
  ['W trakcie antybiotyku', 'Enterol · Dicoflor · LoGGic', 'S. boulardii i/lub LGG.'],
  ['Po antybiotyku', 'OMNi-BiOTiC · Enterol · Dicoflor · Sanprobi Super Formula · LoGGic', 'Kontynuować od kilku tygodni do kilku miesięcy.'],
  ['SIBO / IMO', 'Enterol · Sanprobi IBS · Sanbiotics IBS', 'Ostrożnie z wysokimi dawkami Lactobacillus w fazie aktywnej.'],
  ['Wrzodziejące zapalenie jelita grubego', 'Vivomixx · Mutaflor · Dicoflor · LoGGic', 'Dodatek do standardowego leczenia.'],
  ['Choroba Leśniowskiego-Crohna', 'OMNi-BiOTiC · Sanprobi Barrier · Dicoflor · LoGGic', 'Wsparcie wspomagające, nie leczenie pierwszego rzutu.'],
  ['Odporność ogólna', 'OMNi-BiOTiC · ProbioMax · Aliness ProbioBalance · BestBiotic · Sanprobi Barrier', 'Wysoka różnorodność szczepów.'],
  ['Wzdęcia, gazy, niestrawność', 'Sanprobi IBS · Symbiosys Alflorex · Lactibiane · Nutridome Pro 10', 'Wysoka dawka i różnorodność.'],
  ['Dzieci', 'Wersje dziecięce: Sanprobi · Lactibiane · ProbioMax · Dicoflor Junior', 'Zawsze sprawdź wersję dla dzieci.'],
  ['Zakażenia układu moczowo-płciowego', 'Dopochwowo: InVag · Lactovaginal · Lakcid Intima. Doustnie: ProVag · Gynophilus UroLact · Lacibios Femina · MultiURI', 'MultiURI zawiera też D-mannozę.'],
  ['Choroby nosogardła', 'Entitis · Eminis', 'Odbudowa miejscowej flory.'],
  ['Eradykacja H. pylori', 'HelicoGastrin', 'L. reuteri DSM 17648 + S. boulardii CNCM I-3799.'],
  ['Stres', 'Sanprobi Stres · Dicoflor · LoGGic', 'Gdy stres daje objawy brzuszne: Sanprobi IBS, Asecurin IBS.'],
  ['Skóra', 'LoGGic · Dicoflor', 'Warto połączyć z laktoferyną i cynkiem.'],
];

const gutProtocol = [
  ['Sanprobi Barrier', '2–4 kapsułki dziennie', 'Z posiłkiem', '4–8 tygodni, często 3 miesiące'],
  ['Colostrum', '1–2 g dziennie', 'Na czczo, 30 min przed posiłkiem', '4–12 tygodni'],
  ['Maślan sodu', '150–300 mg czystego maślanu (sprawdź etykietę)', 'Z posiłkiem', '3–6 miesięcy lub dłużej'],
  ['L-glutamina', '5–10 g dziennie', 'Na czczo, 2 dawki', '8–12 tygodni'],
  ['S. boulardii (Enterol)', 'Wg ulotki', 'Codziennie', '4–6 tygodni'],
  ['Cynk', '20–30 mg jonów cynku', 'Wieczorem', '8–12 tygodni'],
  ['Probiotyk wieloszczepowy', 'Wg ulotki', 'Codziennie', 'ok. 12 tygodni'],
];
---

<SiteLayout title="Polecane produkty — Natalia i Donat Cupiał">
  <PageHeader
    eyebrow="Polecane produkty"
    title="Rzeczy, którym ufamy"
    lead="Przykładowe substancje i preparaty, które omawiamy z pacjentami przy zdrowiu jelit, odporności i regeneracji. Zachęcamy do własnego researchu."
  />

  <section class="section site-container">
    <p class="prod-note reveal">
      Materiał ma charakter informacyjny i nie zastępuje konsultacji lekarskiej. Probiotyki działają
      szczepowo-specyficznie, a dobór preparatu i dawek warto omówić z lekarzem.
    </p>

    <h2 class="sub-title">Substancje i przykładowe preparaty</h2>
    <div class="phil-grid reveal">
      {substances.map((item) => (
        <div class="phil-card">
          <h3>{item.title}</h3>
          <span class="prod-eg">{item.examples}</span>
          <p>{item.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section site-container">
    <h2 class="sub-title">Probiotyki: co na jaki problem</h2>
    <p class="prod-lead">
      Praktyczne zestawienie preparatów o najlepszym wsparciu naukowym dla poszczególnych problemów.
      Nie każdy probiotyk nadaje się do przyjmowania w trakcie lub po antybiotyku.
    </p>
    <div class="table-wrap reveal">
      <table class="prod-table">
        <thead>
          <tr><th>Problem</th><th>Przykładowe preparaty</th><th>Uwagi</th></tr>
        </thead>
        <tbody>
          {probioticTable.map((row) => (
            <tr>
              {row.map((cell) => <td>{cell}</td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 class="sub-title">Uszczelnianie jelita: przykładowy schemat</h2>
    <p class="prod-lead">
      Podstawą jest eliminacja tego, co szkodzi (dieta, NLPZ, alkohol, stres); sama dieta zwykle nie
      wystarcza. Kolejność: dieta + Sanprobi Barrier, po 1–2 tygodniach maślan i glutamina, potem
      colostrum. Intensywny protokół trwa zwykle 8–12 tygodni, a w ciężkich przypadkach 4–6 miesięcy.
    </p>
    <div class="table-wrap reveal">
      <table class="prod-table">
        <thead>
          <tr>
            <th>Preparat</th><th>Typowa dawka</th><th>Jak brać</th><th>Czas</th>
          </tr>
        </thead>
        <tbody>
          {gutProtocol.map((row) => (
            <tr>
              {row.map((cell) => <td>{cell}</td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</SiteLayout>
