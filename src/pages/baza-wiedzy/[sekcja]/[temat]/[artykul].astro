---
import { getEntry, render } from 'astro:content';
import SiteLayout from '../../../../layouts/SiteLayout.astro';
import PageHeader from '../../../../components/PageHeader.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import {
  articlesForTopic,
  findSection,
  findTopic,
  isPublished,
  loadKnowledgeBase,
  topicHref,
  topicsForSection,
} from '../../../../utils/knowledge';
import { withBase } from '../../../../utils/url';

export async function getStaticPaths() {
  const { sections, topics, articles } = await loadKnowledgeBase();
  const paths: Array<{
    params: { sekcja: string; temat: string; artykul: string };
  }> = [];

  for (const section of sections) {
    if (section.data.href || section.data.kind === 'supplements') continue;

    for (const topic of topicsForSection(topics, section.id)) {
      for (const article of articlesForTopic(articles, topic.id)) {
        if (!isPublished(article)) continue;

        paths.push({
          params: {
            sekcja: section.id,
            temat: topic.id,
            artykul: article.id,
          },
        });
      }
    }
  }

  return paths;
}

const { sekcja, temat, artykul } = Astro.params;
const { sections, topics, articles } = await loadKnowledgeBase();
const section = findSection(sections, sekcja);
const topic = findTopic(topics, temat);
const article = articles.find((candidate) => candidate.id === artykul);

if (!section) {
  throw new Error(`Nie znaleziono sekcji Bazy wiedzy: ${sekcja}`);
}

if (!topic) {
  throw new Error(`Nie znaleziono tematu Bazy wiedzy: ${temat}`);
}

if (!article) {
  throw new Error(`Nie znaleziono artykułu Bazy wiedzy: ${artykul}`);
}

const pageEntry = await getEntry('bazaWiedzyPage', 'index');
const disclaimer =
  pageEntry?.data.disclaimer ||
  'Materiały mają charakter edukacyjny i nie zastępują indywidualnej konsultacji lekarskiej.';

const { Content } = await render(article);
---

<SiteLayout
  title={`${article.data.title} — ${section.data.title} | Holimedicine`}
  description={
    article.data.teaser ||
    topic.data.summary ||
    section.data.summary ||
    `Materiał edukacyjny: ${article.data.title}.`
  }
  type="article"
>
  <PageHeader
    eyebrow={section.data.title}
    title={article.data.title}
    lead={article.data.teaser || undefined}
  />

  <article class="section site-container kb-article">
    <Breadcrumbs
      items={[
        { label: 'Baza wiedzy', href: withBase('/baza-wiedzy/') },
        {
          label: section.data.title,
          href: withBase(`/baza-wiedzy/${section.id}/`),
        },
        {
          label: topic.data.title,
          href: topicHref(section.id, topic.id),
        },
        { label: article.data.title },
      ]}
    />

    <p class="kb-article-meta">Autor: {article.data.author}</p>

    <div class="rich-text kb-article-content">
      <Content />
    </div>

    <p class="kb-disclaimer">{disclaimer}</p>
  </article>
</SiteLayout>
