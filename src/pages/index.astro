---
import { getEntry, render } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import HeroBanner from '../components/HeroBanner.astro';
import { withBase } from '../utils/url';

const aboutEntry = await getEntry('about', 'index');
const podejscieEntry = await getEntry('podejscie', 'index');
const zakresEntry = await getEntry('zakres', 'index');
const contactEntry = await getEntry('contact', 'index');

if (!aboutEntry || !podejscieEntry || !zakresEntry || !contactEntry) {
  throw new Error('Brak treści strony głównej w CMS.');
}

const { Content: Mission } = await render(aboutEntry);
const { Content: ApproachIntro } = await render(podejscieEntry);

const about = aboutEntry.data;
const podejscie = podejscieEntry.data;
const zakres = zakresEntry.data;
const contact = contactEntry.data;

const slugifyProfileName = (name: string) =>
  name
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/ł/g, 'l')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');

const profiles = about.profiles.map((profile) => ({
  ...profile,
  dialogId: `profil-${slugifyProfileName(profile.name)}`,
}));
---

<SiteLayout
  title="Holimedicine — medycyna holistyczna i terapia manualna"
  description="Medycyna holistyczna i terapia manualna w Zawierciu. Natalia i Donat Cupiał — lekarze rodzinni, którzy łączą diagnostykę, terapię manualną i profilaktykę."
  navOverlay
>
  <!-- HERO -->
  <HeroBanner />

  <!-- O NAS -->
  <section class="section site-container" id="o-nas">
    <div class="section-head reveal">
      <p class="eyebrow">{about.eyebrow}</p>
      <h2>{about.heading}</h2>
    </div>

    <div class="mission reveal">
      <Mission />
    </div>

    {about.photo && (
      <div class="couple-photo-wrap reveal">
        <img src={withBase(about.photo)} alt={about.photoAlt ?? ''} loading="lazy" />
      </div>
    )}

    <div class="profiles-grid reveal">
      {profiles.map((profile) => (
        <article class="profile-card">
          <div class="role">{profile.role}</div>
          <h3>{profile.name}</h3>
          <p class="profile-card-bio">{profile.bio}</p>
          <span class="profile-card-more" aria-hidden="true">Czytaj więcej →</span>
          <button
            type="button"
            class="profile-card-open"
            aria-haspopup="dialog"
            aria-controls={profile.dialogId}
            aria-label={`Czytaj więcej o: ${profile.name}`}
            data-dialog={profile.dialogId}
          />
        </article>
      ))}
    </div>
  </section>

  {profiles.map((profile) => (
    <dialog
      class="profile-modal"
      id={profile.dialogId}
      aria-labelledby={`${profile.dialogId}-title`}
    >
      <button
        type="button"
        class="profile-modal-close"
        aria-label={`Zamknij profil: ${profile.name}`}
        data-close-dialog
      >
        <span aria-hidden="true">×</span>
      </button>

      <div class="profile-modal-scroll">
        <div class="profile-modal-body">
          <p class="profile-modal-role">{profile.role}</p>
          <h2 id={`${profile.dialogId}-title`}>{profile.name}</h2>

          {profile.photo && (
            <figure class="profile-modal-photo">
              <img
                src={withBase(profile.photo)}
                alt={profile.photoAlt ?? ''}
                loading="lazy"
              />
            </figure>
          )}

          <div class="profile-modal-bio">
            {profile.bio.split(/\n+/).map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>

          {profile.gallery.length > 0 && (
            <div class="profile-gallery-wrap">
              <h3 class="profile-gallery-heading">Grafiki i dokumenty</h3>
              <ul class="profile-gallery">
                {profile.gallery.map((item) => (
                  <li class="profile-gallery-item">
                    <figure>
                      <img src={withBase(item.image)} alt={item.alt ?? ''} loading="lazy" />
                      {(item.caption || item.document) && (
                        <figcaption>
                          {item.caption && <span>{item.caption}</span>}
                          {item.document && (
                            <a href={withBase(item.document)} target="_blank" rel="noopener">
                              Otwórz dokument (PDF)
                            </a>
                          )}
                        </figcaption>
                      )}
                    </figure>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    </dialog>
  ))}

  <!-- PODEJŚCIE -->
  <section class="section site-container" id="podejscie">
    <div class="section-head reveal">
      <p class="eyebrow">{podejscie.eyebrow}</p>
      <h2>{podejscie.heading}</h2>
      <ApproachIntro />
    </div>
    <div class="phil-grid">
      {podejscie.pillars.map((pillar) => (
        <div class="phil-card reveal">
          <h3>{pillar.title}</h3>
          <p>{pillar.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ZAKRES OPIEKI -->
  <section class="section site-container" id="zakres">
    <div class="section-head reveal">
      <p class="eyebrow">{zakres.eyebrow}</p>
      <h2>{zakres.heading}</h2>
    </div>
    <div class="services-grid reveal">
      {zakres.items.map((item) => (
        <div class="service-item">
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- KONTAKT -->
  <section class="section site-container" id="kontakt">
    <div class="contact-box reveal">
      <h2>{contact.heading}</h2>
      <p>{contact.lead}</p>

      <details class="contact-faq visit-faq">
        <summary>{contact.visitQuestion}</summary>
        <p>{contact.visitAnswer}</p>
      </details>

      {contact.pricingItems.length > 0 && (
        <details class="contact-faq pricing">
          <summary>{contact.pricingHeading}</summary>
          <ul>
            {contact.pricingItems.map((item) => (
              <li>
                <span>{item.name}</span>
                <span>{item.price}</span>
              </li>
            ))}
          </ul>
        </details>
      )}

      <div class="contact-meta">
        <div><strong>Telefon</strong>{contact.phone}</div>
        <div><strong>E-mail</strong>{contact.email}</div>
        <div><strong>Gabinet</strong>{contact.address}</div>
      </div>
      <div class="hero-actions justify-center mt-8">
        <a href={contact.primaryCtaHref} class="btn-primary">{contact.primaryCtaLabel}</a>
        <a href={contact.secondaryCtaHref} class="btn-secondary">{contact.secondaryCtaLabel}</a>
      </div>
    </div>
  </section>

  <script>
    import { initModalGroup } from '../scripts/modals';

    initModalGroup({
      dialogSelector: 'dialog.profile-modal',
      triggerSelector: '.profile-card-open',
      getDialogId: (button) => button.dataset.dialog,
    });
  </script>
</SiteLayout>
