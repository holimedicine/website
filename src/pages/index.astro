---
import { getEntry, render } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import { withBase } from '../utils/url';

const aboutEntry = await getEntry('about', 'index');
const podejscieEntry = await getEntry('podejscie', 'index');
const zakresEntry = await getEntry('zakres', 'index');

if (!aboutEntry || !podejscieEntry || !zakresEntry) {
  throw new Error('Brak treści strony głównej w CMS.');
}

const { Content: Mission } = await render(aboutEntry);
const { Content: ApproachIntro } = await render(podejscieEntry);

const about = aboutEntry.data;
const podejscie = podejscieEntry.data;
const zakres = zakresEntry.data;
---

<SiteLayout
  title="Natalia i Donat Cupiał — holimedicine.eu.org"
  description="Medycyna rodzinna i holistyczne podejście do zdrowia. Natalia i Donat Cupiał."
>
  <!-- HERO -->
  <header class="hero">
    <svg
      class="hero-motif"
      viewBox="0 0 400 300"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <path
        d="M200 300 C198 240 202 200 190 160 C178 120 150 100 120 70"
        stroke="var(--color-accent-red)"
        stroke-width="1.6"
        opacity="0.6"></path>
      <path
        d="M190 160 C205 130 230 115 260 95"
        stroke="var(--color-accent-red)"
        stroke-width="1.2"
        opacity="0.45"></path>
      <path
        d="M200 300 C202 235 200 190 215 150 C230 110 265 90 300 60"
        stroke="var(--color-accent-gold)"
        stroke-width="1.4"
        opacity="0.5"></path>
      <path
        d="M120 70 C105 55 95 35 88 10"
        stroke="var(--color-accent-red)"
        stroke-width="1"
        opacity="0.4"></path>
      <path
        d="M120 70 C138 60 150 45 155 25"
        stroke="var(--color-accent-red)"
        stroke-width="1"
        opacity="0.4"></path>
      <path
        d="M260 95 C275 80 280 60 275 35"
        stroke="var(--color-accent-gold)"
        stroke-width="1"
        opacity="0.4"></path>
      <path
        d="M215 150 C195 140 178 145 160 130"
        stroke="var(--color-accent-red)"
        stroke-width="1"
        opacity="0.35"></path>
    </svg>
    <svg
      class="hero-motif-heart"
      viewBox="0 0 200 200"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <path
        d="M100 170 C40 130 15 95 15 65 C15 40 35 22 58 22 C75 22 90 32 100 48 C110 32 125 22 142 22 C165 22 185 40 185 65 C185 95 160 130 100 170 Z"
        stroke="var(--color-accent-red)"
        stroke-width="1.4"
        opacity="0.55"></path>
      <path
        d="M20 90 L55 90 L68 65 L82 115 L95 80 L105 100 L180 100"
        stroke="var(--color-accent-gold)"
        stroke-width="1.2"
        opacity="0.6"></path>
    </svg>
    <div class="hero-inner">
      <p class="eyebrow">Medycyna rodzinna · podejście holistyczne · holimedicine.eu.org</p>
      <h1>Leczymy <span class="accent">całego człowieka</span>,<br />nie tylko listę objawów.</h1>
      <p class="lead">
        Jesteśmy małżeństwem lekarzy. Łączymy rzetelną diagnostykę medycyny rodzinnej z uważnym
        spojrzeniem na sen, stres, dietę i codzienne nawyki — bo to one najczęściej decydują o zdrowiu
        na co dzień.
      </p>
      <div class="hero-actions">
        <a href="#kontakt" class="btn-primary">Umów wizytę</a>
        <a href="#o-nas" class="btn-secondary">Poznaj nas</a>
      </div>
    </div>
  </header>

  <!-- O NAS -->
  <section class="section site-container" id="o-nas">
    <div class="section-head reveal">
      <p class="eyebrow">{about.eyebrow}</p>
      <h2>{about.heading}</h2>
    </div>

    <div class="mission reveal">
      <Mission />
    </div>

    {about.photo && (
      <div class="couple-photo-wrap reveal">
        <img src={withBase(about.photo)} alt={about.photoAlt ?? ''} loading="lazy" />
      </div>
    )}

    <div class="profiles-grid reveal">
      {about.profiles.map((profile) => (
        <div class="profile-card">
          <div class="role">{profile.role}</div>
          <h3>{profile.name}</h3>
          <p>{profile.bio}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- PODEJŚCIE -->
  <section class="section site-container" id="podejscie">
    <div class="section-head reveal">
      <p class="eyebrow">{podejscie.eyebrow}</p>
      <h2>{podejscie.heading}</h2>
      <ApproachIntro />
    </div>
    <div class="phil-grid">
      {podejscie.pillars.map((pillar) => (
        <div class="phil-card reveal">
          <h3>{pillar.title}</h3>
          <p>{pillar.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ZAKRES OPIEKI -->
  <section class="section site-container" id="zakres">
    <div class="section-head reveal">
      <p class="eyebrow">{zakres.eyebrow}</p>
      <h2>{zakres.heading}</h2>
    </div>
    <div class="services-grid reveal">
      {zakres.items.map((item) => (
        <div class="service-item">
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- OPINIE -->
  <section class="section site-container" id="opinie">
    <div class="section-head reveal">
      <p class="eyebrow">Opinie</p>
      <h2>Co mówią pacjenci</h2>
      <p>Zostaw opinię o naszej działalności — podaj imię, nazwisko i adres e-mail.</p>
    </div>
    <div class="reviews-wrap reveal">
      <form class="review-form" id="reviewForm">
        <label for="reviewName">Imię i nazwisko</label>
        <input type="text" id="reviewName" required />
        <label for="reviewEmail">Adres e-mail</label>
        <input type="email" id="reviewEmail" required />
        <label for="reviewText">Treść opinii</label>
        <textarea id="reviewText" required></textarea>
        <button type="submit" class="btn-primary">Dodaj opinię</button>
        <p class="form-note">
          E-mail nie będzie publicznie widoczny — potrzebujemy go tylko do weryfikacji. Opinie
          zapisują się lokalnie w tej przeglądarce.
        </p>
      </form>
      <div>
        <div class="review-list" id="reviewList"></div>
      </div>
    </div>
  </section>

  <!-- KONTAKT -->
  <section class="section site-container" id="kontakt">
    <div class="contact-box reveal">
      <h2>Porozmawiajmy o Twoim zdrowiu</h2>
      <p>Umów wizytę w gabinecie lub napisz, jeśli chcesz najpierw zapytać, czy możemy pomóc.</p>
      <div class="contact-meta">
        <div><strong>Telefon</strong>+48 000 000 000</div>
        <div><strong>E-mail</strong>dscupial@gmail.com</div>
        <div><strong>Gabinet</strong>ul. Paderewskiego 25, 42-400 Zawiercie</div>
      </div>
      <div class="hero-actions justify-center mt-8">
        <a href="mailto:kontakt@holimedicine.eu.org" class="btn-primary">Napisz e-mail</a>
        <a href="tel:+48000000000" class="btn-secondary">Zadzwoń</a>
      </div>
    </div>
  </section>

  <script>
    const STORAGE_KEY = 'cupial-gabinet-opinie';
    const reviewForm = document.getElementById('reviewForm') as HTMLFormElement | null;
    const reviewList = document.getElementById('reviewList');

    function loadReviews(): Array<{ name: string; email: string; text: string; date: string }> {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        return raw ? JSON.parse(raw) : [];
      } catch (e) {
        return [];
      }
    }

    function saveReviews(reviews: unknown[]) {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(reviews));
    }

    function escapeHtml(str: string) {
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    }

    function renderReviews() {
      if (!reviewList) return;
      const reviews = loadReviews();
      if (reviews.length === 0) {
        reviewList.innerHTML =
          '<p class="review-empty">Na razie brak opinii — bądź pierwszą osobą, która ją doda.</p>';
        return;
      }
      reviewList.innerHTML = reviews
        .slice()
        .reverse()
        .map(
          (r) => `
          <div class="review-item">
            <span class="review-name">${escapeHtml(r.name)}</span>
            <span class="review-date">${escapeHtml(r.date)}</span>
            <p>${escapeHtml(r.text)}</p>
          </div>
        `
        )
        .join('');
    }

    reviewForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = (document.getElementById('reviewName') as HTMLInputElement).value.trim();
      const email = (document.getElementById('reviewEmail') as HTMLInputElement).value.trim();
      const text = (document.getElementById('reviewText') as HTMLTextAreaElement).value.trim();
      if (!name || !email || !text) return;

      const reviews = loadReviews();
      reviews.push({ name, email, text, date: new Date().toLocaleDateString('pl-PL') });
      saveReviews(reviews);
      renderReviews();
      reviewForm.reset();
    });

    renderReviews();
  </script>
</SiteLayout>
