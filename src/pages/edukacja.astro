---
import { getEntry } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ArticleCard from '../components/ArticleCard.astro';
import {
  articleHref,
  articlesForSection,
  findTopic,
  isPublished,
  loadKnowledgeBase,
} from '../utils/knowledge';
import { slugify } from '../utils/slug';
import { withBase } from '../utils/url';

const [pageEntry, { sections, topics, articles }] = await Promise.all([
  getEntry('bazaWiedzyPage', 'index'),
  loadKnowledgeBase(),
]);

const disclaimer =
  pageEntry?.data.disclaimer ||
  'Materiały mają charakter edukacyjny i nie zastępują indywidualnej konsultacji lekarskiej.';

const groups = sections
  .map((section) => ({
    section,
    articles: articlesForSection(articles, section.id).filter(isPublished),
  }))
  .filter((group) => group.articles.length > 0);
---

<SiteLayout
  title="Wszystkie artykuły — Baza wiedzy | Holimedicine"
  description="Wszystkie opublikowane materiały edukacyjne Holimedicine: styl życia, żywienie, zdrowie według układów i przegląd tego, co mówi nauka."
>
  <PageHeader
    eyebrow="Baza wiedzy"
    title="Wszystkie artykuły"
    lead="Pełna lista opublikowanych materiałów edukacyjnych. Możesz też wejść w konkretną sekcję Bazy wiedzy."
  />

  <section class="section site-container kb-page">
    <Breadcrumbs
      items={[
        { label: 'Baza wiedzy', href: withBase('/baza-wiedzy/') },
        { label: 'Wszystkie artykuły' },
      ]}
    />

    {
      groups.map(({ section, articles: sectionArticles }) => (
        <div class="kb-article-group">
          <h2 class="sub-title">{section.data.title}</h2>
          <div class="kb-grid reveal">
            {sectionArticles.map((article) => {
              const topic = article.data.topic
                ? findTopic(topics, article.data.topic)
                : undefined;

              return (
                <ArticleCard
                  title={article.data.title}
                  teaser={article.data.teaser}
                  eyebrow={topic?.data.title}
                  href={articleHref(section.id, article.data.topic, article.id)}
                  slug={slugify(article.id)}
                />
              );
            })}
          </div>
        </div>
      ))
    }

    <p class="kb-disclaimer">{disclaimer}</p>
  </section>

  <script>
    // Preserve old /edukacja/#edukacja-<slug> deep links after articles moved
    // to their own pages.
    const legacyPrefix = '#edukacja-';
    if (window.location.hash.startsWith(legacyPrefix)) {
      const slug = window.location.hash.slice(legacyPrefix.length);
      const target = document.querySelector(`[data-article-slug="${CSS.escape(slug)}"]`);
      if (target instanceof HTMLAnchorElement) {
        window.location.replace(target.href);
      }
    }
  </script>
</SiteLayout>
