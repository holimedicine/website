---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { withBase } from '../utils/url';

const recipes = await getCollection('przepisy');
const categories = (await getCollection('kategoriePrzepisow')).sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title, 'pl')
);

type RecipeEntry = (typeof recipes)[number];

const recipesById = new Map(recipes.map((entry) => [entry.id, entry]));
const problems: string[] = [];

const groups = categories.map((category) => {
  const seen = new Set<string>();
  const entries: RecipeEntry[] = [];

  for (const slug of category.data.recipes) {
    if (seen.has(slug)) {
      problems.push(`„${slug}” występuje więcej niż raz w kategorii „${category.data.title}”.`);
      continue;
    }
    seen.add(slug);

    const entry = recipesById.get(slug);
    if (!entry) {
      problems.push(`Kategoria „${category.data.title}” wskazuje nieistniejący przepis „${slug}”.`);
      continue;
    }

    entries.push(entry);
  }

  return { category, entries };
});

if (problems.length > 0) {
  throw new Error(`Problemy z kategoriami przepisów:\n- ${problems.join('\n- ')}`);
}
---

<SiteLayout title="Przepisy — Natalia i Donat Cupiał">
  <PageHeader
    eyebrow="Przepisy"
    title="Jemy tak, jak zalecamy"
    lead="Przepisy niskowęglowodanowe, bogate w warzywa i zdrowe tłuszcze — zgodnie z zasadami, które sami stosujemy na co dzień."
  />

  <section class="section site-container">
    <div class="subcat-tabs">
      {groups.map(({ category }, index) => (
        <button
          type="button"
          class:list={['subcat-tab', { active: index === 0 }]}
          data-target={category.id}
        >
          {category.data.title}
        </button>
      ))}
    </div>

    {groups.map(({ category, entries }, index) => (
      <div class:list={['subcat-panel', { active: index === 0 }]} id={category.id}>
        {entries.length === 0 ? (
          <p class="recipe-empty">Brak przepisów w tej kategorii.</p>
        ) : (
          <div class="recipes-grid reveal">
            {entries.map((entry) => (
              <div class="recipe-card">
                {entry.data.coverImage && (
                  <img
                    src={withBase(entry.data.coverImage)}
                    alt={entry.data.alt}
                    class="recipe-img"
                    loading="lazy"
                  />
                )}
                <div class:list={['recipe-tag', { 'with-img': Boolean(entry.data.coverImage) }]}>
                  {entry.data.tag}
                </div>
                <h3>{entry.data.title}</h3>
                <p>{entry.data.summary}</p>
              </div>
            ))}
          </div>
        )}
      </div>
    ))}
  </section>

  <script>
    const tabs = document.querySelectorAll<HTMLButtonElement>('.subcat-tab');
    const panels = document.querySelectorAll<HTMLElement>('.subcat-panel');
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => t.classList.remove('active'));
        panels.forEach((p) => p.classList.remove('active'));
        tab.classList.add('active');
        const target = tab.dataset.target;
        if (target) document.getElementById(target)?.classList.add('active');
      });
    });
  </script>
</SiteLayout>
